# =============================================================================
# 前端（静态站点 + /api 反代）
# -----------------------------------------------------------------------------
# 同源部署（默认）：浏览器请求 /api/* -> nginx -> http://server:8000
# 前后端分开部署：把 .env 的 API_UPSTREAM 改成外部地址，例如
#   API_UPSTREAM=https://api.example.com
# 前端 index.html 里**没有**任何 localhost / IP / 域名，全靠这里决定转发目标。
#
# 本文件是 nginx 官方镜像的 template：容器启动时会自动 envsubst 渲染成
# /etc/nginx/conf.d/nginx.conf（只替换 ${API_UPSTREAM}，nginx 自己的 $host
# 等变量不受影响）。
# =============================================================================
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 让浏览器缓存静态资源，但 HTML 本身不缓存（改了页面要能立刻生效）
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # ---- /api 反代到服务端 ----
    # proxy_pass 末尾**不能**带 / ：带了会把 /api 前缀吃掉，后端路由就对不上了。
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 连线图 zip 是几十 MB，别让它超时；也别在 nginx 里缓冲，否则要等满才开下
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;
        proxy_buffering       off;
        proxy_request_buffering off;
        client_max_body_size  0;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
