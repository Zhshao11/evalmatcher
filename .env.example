# =============================================================================
# EvalMatcher 部署配置（复制本文件为 .env 后按需修改）
#   cp .env.example .env
#
# 只放**部署相关**的参数：端口、宿主机挂载路径、GPU 编号、配置文件路径。
# 算法相关（方法、权重文件名、阈值、device）在 config/server.yaml 里，两边不混。
#
# 安全：.env 已在 .gitignore 里，不要提交真实 .env、密码、Token 或私钥。
# =============================================================================

# ---------------- 端口 ----------------
# 网站对外端口（浏览器访问 http://<本机IP>:8080/）
WEB_PORT=8080
# 服务端 API 端口（直接调后端时用；前端默认走 nginx 反代，不需要对外暴露）
API_PORT=8000

# ---------------- 前后端通信 ----------------
# 前端 nginx 把 /api 反代到这里。同一台机器保持默认即可。
API_UPSTREAM=http://server:8000
# 只在「前端单独部署到别的域名」时填写，例如 https://api.example.com
# 填了会以 window.__EM_API_BASE__ 注入前端，前端就不再请求同源 /api
EXTERNAL_API_BASE=

# ---------------- 宿主机目录（容器内会挂成固定路径） ----------------
# 权重目录 -> 容器内 /app/weights（只读）
WEIGHTS_DIR=/path/to/evalmatcher-weights
# 数据集目录 -> 容器内 /app/data（只读）
#   结构必须是 <DATASET_DIR>/VIS_SAR/test/{VIS,SAR,transforms}
DATASET_DIR=/path/to/evalmatcher-data
# 结果输出目录 -> 容器内 /app/output（可写）
#   评测存档 / 导出报表 / 连线图 zip 都写在这里
OUTPUT_DIR=/path/to/evalmatcher-output

# ---------------- 服务端算法配置文件 ----------------
# 仓库自带的 config/server.yaml；想换一份算法配置就指向别的文件
SERVER_CONFIG_FILE=./config/server.yaml

# ---------------- GPU ----------------
# 用哪几块 GPU（nvidia-smi 里的编号，多卡写 0,1）
GPU_IDS=0
# cuda | cpu。cpu 只能冒烟跑几对，全量 424 对会很慢
DEVICE=cuda

# ---------------- 构建参数（一般不用改） ----------------
# torch 版本与 CUDA wheel 源，要和宿主机驱动支持的 CUDA 对齐
TORCH_VERSION=2.11.0
TORCHVISION_VERSION=0.26.0
CUDA_TAG=cu128
# 想跳过 pip 装 torch（改用自带 torch 的基础镜像）：
#   BASE_IMAGE=pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

TZ=Asia/Shanghai
